{
    "name": "blemli/specialchars-for-filament",
    "description": "The characters a keyboard lacks, one click away on any Filament text field.",
    "keywords": [
        "blemli",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "special-characters",
        "symbols",
        "unicode",
        "text-input",
        "specialchars-for-filament"
    ],
    "homepage": "https://github.com/blemli/specialchars-for-filament",
    "support": {
        "issues": "https://github.com/blemli/specialchars-for-filament/issues",
        "source": "https://github.com/blemli/specialchars-for-filament"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "blemli",
            "email": "apps@problem.li",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Blemli\\SpecialChars\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blemli\\SpecialChars\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blemli\\SpecialChars\\SpecialCharsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "suggest": {
        "ext-intl": "Names the characters (tooltips and dropdown labels) — without it they read as U+XXXX."
    }
}
